## NBA Data Pipeline — containerized ingestion
FROM node:22-alpine AS base
WORKDIR /app

# Install deps. Yarn is this project's package manager (yarn.lock is the
# maintained lockfile; ci.yml and local dev both use yarn). Using npm here
# broke the build: the stale package-lock.json drifted out of sync with
# package.json and `npm ci` hard-fails on the mismatch.
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# Copy source
COPY src/ src/
COPY scripts/ scripts/
COPY tsconfig.json ./

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s \
  CMD node -e "console.log('ok')" || exit 1

# Default: run full ingestion
ENTRYPOINT ["npx", "tsx"]
CMD ["scripts/ingest-nba.ts"]
