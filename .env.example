# =============================================================================
# zero-next — environment variables
# =============================================================================
# Copy to `.env.local` and fill in real values. `.env*.local` is gitignored;
# this template is the one committed exception (see .gitignore).
#
# Production values live in Vercel → Settings → Environment Variables, NOT here.
# Nothing in this file is required for `yarn dev` to boot — every integration
# degrades gracefully when its vars are unset (missing DB/Stripe/Supabase
# returns a 503 rather than crashing), so you can run the site with an empty
# .env.local and fill in only what you're working on.
#
# Var list derived from:
#   grep -rohE 'process\.env\.[A-Z_0-9]+' src/ | sort -u
# plus the three AI provider keys resolved dynamically in
# src/lib/ai-providers/providers.ts (envKey), which that grep cannot see.
# =============================================================================


# --- Database: Neon Postgres -------------------------------------------------
# The business side: leads, checkout_sessions, guestbook, analytics events,
# and the whole NBA medallion pipeline. Game state lives in Supabase instead.
# Read by: src/lib/db.ts. Health check: GET /api/db-health.
POSTGRES_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require


# --- Database: Supabase ------------------------------------------------------
# ALL game state: player profiles, ELO, puzzle bank, game history, multiplayer.
# The anon key is browser-visible by design — protect rows with RLS, not secrecy.
# Read by: src/lib/supabase.ts.
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...


# --- Admin & cron auth -------------------------------------------------------
# Two independent layers; see CLAUDE.md → Authentication.
#
# 1. Machine-facing. ADMIN_KEY is checked against the `x-admin-key` header for
#    manual admin calls; CRON_SECRET against `Authorization: Bearer ...` for
#    Vercel Cron. Both are validated in src/lib/adminAuth.ts, which fails closed
#    when a secret is unset (an earlier bug let `undefined === undefined` pass).
ADMIN_KEY=generate-a-long-random-string
CRON_SECRET=generate-a-different-long-random-string
#
# 2. Browser-facing, gating /tracker and /admin/*. ADMIN_PASSWORD is what you
#    type at /login; ADMIN_SESSION_TOKEN is the opaque value stored in the
#    `tracker_session` cookie and compared by src/proxy.ts. Keep them different.
ADMIN_PASSWORD=your-dashboard-password
ADMIN_SESSION_TOKEN=generate-yet-another-long-random-string


# --- Stripe: consulting checkout ---------------------------------------------
# Server-only — never prefix with NEXT_PUBLIC_. Checkout and the webhook both
# return 503 while unset, so the funnel degrades instead of breaking.
# Read by: src/pages/api/consulting/{checkout,webhook}.ts.
STRIPE_SECRET_KEY=sk_test_...

# Signature verification for `checkout.session.completed`, which flips
# checkout_sessions.status from 'pending' to 'paid'. Get it from
# Stripe Dashboard → Developers → Webhooks after registering the endpoint URL.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. Saved Price IDs per service tier. When a tier's var is set, checkout
# uses `{ price, quantity: 1 }`; otherwise it falls back to inline price_data
# with identical behavior. Set these for cleaner Stripe reporting and Stripe Tax.
STRIPE_PRICE_STRATEGY=price_...
STRIPE_PRICE_SPRINT=price_...
STRIPE_PRICE_FRACTIONAL=price_...


# --- Stripe / tip jar: public links ------------------------------------------
# NEXT_PUBLIC_* is exposed to the browser — put only shareable URLs here.
# While these hold placeholders the tip buttons render a disabled "Coming soon"
# state; pasting real URLs re-enables them with no code change.
# Read by: src/pages/{funding.tsx,tracker.jsx,zero-paradox.jsx}.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
NEXT_PUBLIC_PAYPAL_ME=https://paypal.me/yourhandle
NEXT_PUBLIC_VENMO_HANDLE=@your-venmo-handle


# --- AI providers ------------------------------------------------------------
# Back the Chat Sandbox (/tools/chat) and Model Arena (/tools/model-arena).
# Resolved dynamically by envKey in src/lib/ai-providers/providers.ts, so a
# grep for `process.env.X` will not find these.
#
# All three are optional: a caller may supply their own key via the BYOK request
# header, which takes precedence over the env var (src/lib/ai-providers/keys.ts).
# Set at least one to use the tools without BYOK. Requests are rate-limited to
# 30/hr per IP regardless (10/hr for profile generation).
OPENROUTER_API_KEY=sk-or-v1-...
GROQ_API_KEY=gsk_...
CEREBRAS_API_KEY=csk-...


# --- Email: Resend -----------------------------------------------------------
# Best-effort notifications only — lead capture and email signups still succeed
# when this is unset; the send is a no-op.
# Read by: src/pages/api/events.ts, src/pages/api/intake/send.js.
RESEND_API_KEY=re_...


# --- NBA pipeline ------------------------------------------------------------
# The Odds API key for betting lines, used by the prediction simulator and the
# Rig Report tool. Both cache aggressively and fall back to demo data when
# unset, so you will not burn quota during local development.
# Read by: src/pages/api/nba/admin/simulate.ts, src/pages/api/tools/rig-report.ts.
ODDS_API_KEY=your-the-odds-api-key

# Optional. Stamps predictions with the model-calibration version so accuracy
# can be compared across model revisions. Defaults to "v0.2.0" when unset.
# Read by: src/lib/nba/predictions/version.ts.
NBA_CALIBRATION_VERSION=v0.2.0
